# ==============================================================================
# NuraSpace Production Environment Configuration
# ==============================================================================

APP_NAME=NuraSpace
APP_ENV=production
APP_KEY=base64:GhGrIgpxfkey7SLhLprAC+MsV5gFx0CI0Z15Lg4aiKc=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://nuraspace.onrender.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Couple Identity (Misbachul Munir & Syahra Alfi Nur Arintia)
NURASPACE_COUPLE_NAME="Misbachul Munir & Syahra Alfi Nur Arintia"
NURASPACE_ANNIVERSARY="2024-05-12"
NURASPACE_INIT_PASSWORD="SecretPassword123!"

PARTNER_1_NAME="Misbachul Munir"
PARTNER_1_EMAIL="munir@nuraspace.local"
PARTNER_1_BIRTHDATE="1998-08-17"

PARTNER_2_NAME="Syahra Alfi Nur Arintia"
PARTNER_2_EMAIL="syahra@nuraspace.local"
PARTNER_2_BIRTHDATE="2000-04-21"

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Production Database (Pilih salah satu: Supabase / Neon / Render PostgreSQL / MySQL)
# ------------------------------------------------------------------------------
# Jika menggunakan connection string (Supabase / Neon / Koyeb / Render):
DATABASE_URL=postgresql://user:password@host:5432/database_name?sslmode=require
DB_CONNECTION=pgsql

# Atau jika menggunakan parameter terpisah (MySQL / PostgreSQL):
# DB_CONNECTION=mysql
# DB_HOST=your-mysql-host.com
# DB_PORT=3306
# DB_DATABASE=nuraspace_db
# DB_USERNAME=your_username
# DB_PASSWORD=your_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=sync
CACHE_STORE=database

# ------------------------------------------------------------------------------
# Cloud Media Storage (Cloudflare R2 - Gratis 10GB & $0 Biaya Download)
# ------------------------------------------------------------------------------
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your-r2-access-key-id
# AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=nuraspace-media
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
